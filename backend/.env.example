# DMC OS — environment template
#
# Copy this file to `backend/.env` and fill in the real values.
# `.env` is gitignored (see .gitignore line 1), so real secrets never
# reach the repository. This template is committed on purpose.
#
# Nothing here needs a code change to take effect: services/email_service.py
# already calls load_dotenv() at import, and app/engines/booking/service.py
# already attempts a real send for every LPO. Filling this in is the whole
# switch-on.


# ---------------------------------------------------------------------------
# Email (SMTP) — used for LPO / booking confirmations / vouchers
# ---------------------------------------------------------------------------
# Until EMAIL_USER and EMAIL_PASSWORD are both set, nothing is actually
# emailed: the message is printed to the backend console, and every LPO is
# stored with delivered=false, which the booking screen shows as
# "Recorded but NOT emailed".
#
# For Gmail, EMAIL_PASSWORD must be a 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# NOT the account's own password.

EMAIL_HOST=smtp.gmail.com
# 587 uses STARTTLS; any other port is treated as implicit SSL (e.g. 465).
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Defaults to EMAIL_USER when left blank.
EMAIL_FROM=


# ---------------------------------------------------------------------------
# JWT signing key
# ---------------------------------------------------------------------------
# app/engines/authentication/config.py falls back to a RANDOM key when this
# is unset — which is why every backend restart currently signs everyone out.
# Set a real, stable value before any deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=
